  <meta name="keywords" content="Habtamu Education Project, International School, Kindergarten, Primary Education, Secondary Education, Preparatory School, Admissions, Academic Excellence" />
  <meta name="author" content="HABTAMU EDUCATION PROJECT" />

  <!-- Open Graph / Social Sharing Meta -->
