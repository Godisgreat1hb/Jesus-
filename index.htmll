  <!-- Google Fonts: Playfair Display (Editorial Serif) & Plus Jakarta Sans (Clean Modern Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* ==========================================================================
       1. DESIGN TOKENS & CSS CUSTOM PROPERTIES
       ========================================================================== */
    :root {
      --navy-950: #060f1e;
      --navy-900: #0a192f;
      --navy-800: #112240;
      --navy-700: #1d3557;
      --navy-600: #2a4a78;
      --gold-500: #d4af37;
      --gold-400: #e5c358;
      --gold-600: #b5952f;
      --gold-tint: rgba(212, 175, 55, 0.12);
      --white: #ffffff;
      --slate-50: #f8fafc;
      --slate-100: #f1f5f9;
      --slate-200: #e2e8f0;
      --slate-300: #cbd5e1;
      --slate-500: #64748b;
      --slate-600: #475569;
      --slate-700: #334155;
      --slate-800: #1e293b;
      --success: #15803d;
      --success-bg: #dcfce7;
      --error: #b91c1c;
      --error-bg: #fee2e2;

      --font-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

      --shadow-sm: 0 2px 8px rgba(10, 25, 47, 0.06);
      --shadow-md: 0 10px 30px rgba(10, 25, 47, 0.1);
      --shadow-lg: 0 20px 50px rgba(10, 25, 47, 0.18);
      --shadow-gold: 0 8px 25px rgba(212, 175, 55, 0.28);

      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 22px;
      --radius-full: 9999px;

      --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      --transition-smooth: 0.38s cubic-bezier(0.22, 1, 0.36, 1);
      --container-max: 1240px;
    }

    /* ==========================================================================
       2. RESET & BASE TYPOGRAPHY
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
      scroll-padding-top: 86px;
    }

    body {
      font-family: var(--font-sans);
      color: var(--slate-700);
      background-color: var(--white);
      line-height: 1.65;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    img
