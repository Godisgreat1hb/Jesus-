      color: var(--white);
      font-size: 1.12rem;
      margin-bottom: 0.3rem;
    }

    .map-placeholder p {
      position: relative;
      z-index: 2;
      font-size: 0.85rem;
      color: var(--slate-200);
      margin-bottom: 0.85rem;
    }

