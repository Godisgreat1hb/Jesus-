      color: var(--gold-600);
      margin-bottom: 0.75rem;
      display: block;
    }

    .teacher-bio {
      font-size: 0.9rem;
      color: var(--slate-600);
      line-height: 1.6;
    }

    /* ==========================================================================
       10. ADMISSIONS SECTION
       ========================================================================== */
    .admissions-layout {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 3rem;
      align-items: start;
    }

    .admissions-card {
      background: var(--white);
      border-radius: var(--radius-lg);
      padding: 2.35rem;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--slate-200);
    }

    .admissions-card h3 {
      font-size: 1.55rem;
      margin-bottom: 1rem;
    }

    .req-list {
      list-style: none;
      margin: 1.35rem 0 1.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .req-list li {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      font-size: 0.95rem;
      color: var(--slate-700);
    }

    .req-check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--gold-tint);
      color: var(--gold-600);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
      font-weight: 800;
      font-size: 0.78rem;
    }

    .steps-timeline {
      display: flex;
