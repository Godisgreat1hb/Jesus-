      gap: 1.35rem;
    }

    .step-item {
      display: flex;
      gap: 1.25rem;
      background: var(--white);
      padding: 1.5rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--slate-200);
      box-shadow: var(--shadow-sm);
      transition: transform var(--transition-fast), border-color var(--transition-fast);
