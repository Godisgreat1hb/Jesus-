  <style>
    /* ==========================================================================
       1. DESIGN TOKENS & CSS CUSTOM PROPERTIES
       ========================================================================== */
    :root {
      --navy-950: #060f1e;
      --navy-900: #0a192f;
      --navy-800: #112240;
      --navy-700: #1d3557;
      --navy-600: #2a4a78;
      --gold-500: #d4af37;
      --gold-400: #e5c358;
      --gold-600: #b5952f;
      --gold-tint: rgba(212, 175, 55, 0.12);
      --white: #ffffff;
      --slate-50: #f8fafc;
      --slate-100: #f1f5f9;
      --slate-200: #e2e8f0;
      --slate-300: #cbd5e1;
      --slate-500: #64748b;
      --slate-600: #475569;
      --slate-700: #334155;
      --slate-800: #1e293b;
      --success: #15803d;
      --success-bg: #dcfce7;
      --error: #b91c1c;
      --error-bg: #fee2e2;

      --font-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

      --shadow-sm: 0 2px 8px rgba(10, 25, 47, 0.06);
      --shadow-md: 0 10px 30px rgba(10, 25, 47, 0.1);
      --shadow-lg: 0 20px 50px rgba(10, 25, 47, 0.18);
      --shadow-gold: 0 8px 25px rgba(212, 175, 55, 0.28);

      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 22px;
      --radius-full: 9999px;

      --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      --transition-smooth: 0.38s cubic-bezier(0.22, 1, 0.36, 1);
      --container-max: 1240px;
    }

    /* ==========================================================================
       2. RESET & BASE TYPOGRAPHY
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
      scroll-padding-top: 86px;
    }

    body {
      font-family: var(--font-sans);
      color: var(--slate-700);
      background-color: var(--white);
      line-height: 1.65;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: color var(--transition-fast);
    }

    button, input, select, textarea {
      font-family: inherit;
      font-size: inherit;
    }

    button {
      cursor: pointer;
      border: none;
      background: none;
    }

    :focus-visible {
      outline: 3px solid var(--gold-500);
      outline-offset: 3px;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-serif);
      color: var(--navy-900);
      line-height: 1.2;
      font-weight: 700;
    }

    /* ==========================================================================
       3. LAYOUT UTILITIES & REUSABLE COMPONENTS
       ========================================================================== */
    .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .section {
      padding: 5.5rem 0;
      position: relative;
    }

    .section-alt {
      background-color: var(--slate-50);
    }

    .section-dark {
      background: linear-gradient(135deg, var(--navy-950) 0%, var(--navy-900) 55%, var(--navy-800) 100%);
      color: var(--white);
    }

    .section-dark h2, .section-dark h3 {
      color: var(--white);
    }

    .section-header {
      text-align: center;
      max-width: 740px;
      margin: 0 auto 3.5rem;
    }

    .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--gold-600);
      background: var(--gold-tint);
      padding: 0.42rem 1rem;
      border-radius: var(--radius-full);
      margin-bottom: 0.9rem;
    }

    .section-dark .section-eyebrow {
      color: var(--gold-400);
      background: rgba(212, 175, 55, 0.15);
      border: 1px solid rgba(212, 175, 55, 0.25);
    }

    .section-title {
      font-size: clamp(2rem, 3.6vw, 2.85rem);
      margin-bottom: 1rem;
    }

    .section-divider {
      width: 68px;
      height: 3px;
      background: linear-gradient(90deg, var(--gold-500), var(--gold-400));
      margin: 0 auto 1.25rem;
      border-radius: var(--radius-full);
    }

    .section-subtitle {
      font-size: 1.05rem;
      color: var(--slate-600);
    }

    .section-dark .section-subtitle {
      color: var(--slate-300);
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      padding: 0.85rem 1.75rem;
      font-weight: 600;
      font-size: 0.95rem;
      border-radius: var(--radius-full);
      transition: all var(--transition-smooth);
      white-space: nowrap;
    }

    .btn-gold {
      background: linear-gradient(135deg, var(--gold-500), var(--gold-600));
      color: var(--navy-950);
      box-shadow: var(--shadow-gold);
    }

    .btn-gold:hover {
      background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(212, 175, 55, 0.4);
    }

    .btn-navy {
      background-color: var(--navy-900);
      color: var(--white);
      box-shadow: var(--shadow-sm);
    }

    .btn-navy:hover {
      background-color: var(--navy-800);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .btn-outline-light {
      border: 1.5px solid rgba(255, 255, 255, 0.75);
      color: var(--white);
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(6px);
    }

    .btn-outline-light:hover {
      background: var(--white);
      color: var(--navy-900);
      border-color: var(--white);
      transform: translateY(-2px);
    }

    .btn-outline-navy {
      border: 1.5px solid var(--navy-900);
      color: var(--navy-900);
      background: transparent;
    }

    .btn-outline-navy:hover {
      background: var(--navy-900);
      color: var(--white);
      transform: translateY(-2px);
    }

    .btn-sm {
      padding: 0.58rem 1.25rem;
      font-size: 0.875rem;
    }

    /* Scroll Reveal Animations */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================================
       4. TOP UTILITY BAR & STICKY NAVIGATION BAR
       ========================================================================== */
    .top-bar {
      background-color: var(--navy-950);
      color: var(--slate-300);
      font-size: 0.82rem;
      padding: 0.5rem 0;
      border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    }

    .top-bar-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .top-bar-info {
      display: flex;
      align-items: center;
      gap: 1.4rem;
      flex-wrap: wrap;
    }

    .top-bar-item {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .top-bar-item svg {
      color: var(--gold-500);
      flex-shrink: 0;
    }

    .top-bar-badge {
      color: var(--gold-400);
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background-color: var(--gold-500);
      border-radius: 50%;
      display: inline-block;
      animation: pulseGlow 2s infinite;
    }

    @keyframes pulseGlow {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.45); opacity: 0.5; }
    }

    /* Main Sticky Navbar */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(10, 25, 47, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(212, 175, 55, 0.22);
      transition: all var(--transition-smooth);
    }

    .navbar.scrolled {
      background: rgba(6, 15, 30, 0.98);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
    }

    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 82px;
      gap: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      flex-shrink: 0;
    }

    .brand-crest {
      width: 46px;
      height: 46px;
      flex-shrink: 0;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
    }

    .brand-name {
      font-family: var(--font-serif);
      font-size: 1.12rem;
      font-weight: 800;
      color: var(--white);
      letter-spacing: 0.04em;
      line-height: 1.15;
    }

    .brand-tagline {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--gold-400);
      font-weight: 600;
      margin-top: 2px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 0.2rem;
    }

    .nav-link {
      color: var(--slate-200);
      font-size: 0.88rem;
      font-weight: 500;
      padding: 0.55rem 0.78rem;
      border-radius: var(--radius-sm);
      position: relative;
      transition: color var(--transition-fast);
    }

    .nav-link::after {
      content: '';
      position: absolute;
      bottom: 4px;
      left: 0.78rem;
      right: 0.78rem;
      height: 2px;
      background-color: var(--gold-500);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform var(--transition-smooth);
    }

    .nav-link:hover, .nav-link.active {
      color: var(--gold-400);
    }

    .nav-link:hover::after, .nav-link.active::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      border: 1px solid rgba(212, 175, 55, 0.35);
      gap: 5px;
      color: var(--white);
    }

    .hamburger span {
      display: block;
      width: 22px;
      height: 2px;
      background-color: var(--gold-400);
      border-radius: 2px;
      transition: all var(--transition-fast);
    }

    .hamburger.open span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .hamburger.open span:nth-child(2) {
      opacity: 0;
    }

    .hamburger.open span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* Mobile Drawer */
    .mobile-overlay {
      position: fixed;
      inset: 0;
      background: rgba(6, 15, 30, 0.72);
      backdrop-filter: blur(4px);
      z-index: 998;
      opacity: 0;
      visibility: hidden;
      transition: all var(--transition-smooth);
    }

    .mobile-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: min(330px, 85vw);
      height: 100vh;
      background: var(--navy-900);
      z-index: 999;
      padding: 5.5rem 1.75rem 2rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-left: 1px solid rgba(212, 175, 55, 0.25);
      transition: right var(--transition-smooth);
      overflow-y: auto;
    }

    .mobile-drawer.active {
      right: 0;
    }

    .mobile-nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .mobile-nav-link {
      display: block;
      padding: 0.85rem 1rem;
      color: var(--white);
      font-weight: 500;
      font-size: 1.02rem;
      border-radius: var(--radius-sm);
      border-left: 3px solid transparent;
    }

    .mobile-nav-link:hover, .mobile-nav-link.active {
      background: rgba(212, 175, 55, 0.12);
      color: var(--gold-400);
      border-left-color: var(--gold-500);
    }

    /* ==========================================================================
       5. HERO SECTION
       ========================================================================== */
    .hero {
      position: relative;
      min-height: calc(100vh - 82px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background-color: var(--navy-950);
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background-image: url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=2000&q=85');
      background-size: cover;
      background-position: center;
      transform: scale(1.04);
      animation: heroZoom 22s ease-in-out infinite alternate;
    }

    @keyframes heroZoom {
      from { transform: scale(1.02); }
      to { transform: scale(1.1); }
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        115deg,
        rgba(6, 15, 30, 0.92) 0%,
        rgba(10, 25, 47, 0.84) 55%,
        rgba(17, 34, 64, 0.72) 100%
      );
    }

    .hero-content {
      position: relative;
      z-index: 2;
      padding: 5.5rem 0 4rem;
      max-width: 820px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.48rem 1.15rem;
      background: rgba(212, 175, 55, 0.16);
      border: 1px solid rgba(212, 175, 55, 0.45);
      border-radius: var(--radius-full);
      color: var(--gold-400);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
      animation: fadeUp 0.8s ease forwards;
    }

    .hero-title {
      font-size: clamp(2.35rem, 5.2vw, 4.15rem);
      color: var(--white);
      font-weight: 800;
      letter-spacing: 0.01em;
      line-height: 1.12;
      margin-bottom: 1rem;
      animation: fadeUp 0.9s 0.12s ease both;
    }

    .hero-subtitle {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: clamp(1.35rem, 2.6vw, 1.95rem);
      color: var(--gold-400);
      font-weight: 600;
      margin-bottom: 1.35rem;
      animation: fadeUp 0.9s 0.24s ease both;
    }

    .hero-desc {
      font-size: 1.1rem;
      color: var(--slate-200);
      max-width: 650px;
      margin-bottom: 2.35rem;
      line-height: 1.75;
      animation: fadeUp 0.9s 0.36s ease both;
    }

    .hero-cta-group {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      animation: fadeUp 0.9s 0.48s ease both;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Hero Stats Ribbon */
    .hero-stats {
      position: relative;
      z-index: 2;
      background: rgba(17, 34, 64, 0.88);
      backdrop-filter: blur(12px);
      border-top: 1px solid rgba(212, 175, 55, 0.3);
      padding: 1.75rem 0;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }

    .stat-item {
      text-align: center;
      padding: 0.5rem;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
    }

    .stat-item:last-child {
      border-right: none;
    }

    .stat-number {
      font-family: var(--font-serif);
      font-size: clamp(1.85rem, 3vw, 2.5rem);
      font-weight: 800;
      color: var(--gold-400);
      line-height: 1.1;
    }

    .stat-label {
      font-size: 0.86rem;
      color: var(--slate-200);
      font-weight: 500;
      margin-top: 0.35rem;
      letter-spacing: 0.03em;
    }

    /* ==========================================================================
       6. ABOUT US SECTION
       ========================================================================== */
    .about-grid {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 3.75rem;
      align-items: center;
      margin-bottom: 4.5rem;
    }

    .about-media {
      position: relative;
    }

    .about-img-main {
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      width: 100%;
      height: 460px;
      object-fit: cover;
    }

    .about-badge-card {
      position: absolute;
      bottom: -24px;
      right: -20px;
      background: var(--navy-900);
      color: var(--white);
      padding: 1.5rem 1.75rem;
      border-radius: var(--radius-md);
      border-left: 4px solid var(--gold-500);
      box-shadow: var(--shadow-lg);
      max-width: 260px;
    }

    .about-badge-card strong {
      display: block;
      font-family: var(--font-serif);
      font-size: 1.65rem;
      color: var(--gold-400);
      margin-bottom: 0.25rem;
    }

    .about-badge-card span {
      font-size: 0.88rem;
      color: var(--slate-200);
    }

    .about-text h3 {
      font-size: 1.85rem;
      margin-bottom: 1.1rem;
    }

    .about-text p {
      margin-bottom: 1.1rem;
      color: var(--slate-600);
    }

    /* Brief History Timeline Strip */
    .history-box {
      margin-top: 1.75rem;
      padding: 1.35rem 1.5rem;
      background: var(--slate-50);
      border-radius: var(--radius-md);
      border: 1px solid var(--slate-200);
      border-left: 4px solid var(--navy-900);
    }

    .history-box h4 {
      font-size: 1.08rem;
      margin-bottom: 0.45rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--navy-900);
    }

    .history-box p {
      font-size: 0.93rem;
      margin-bottom: 0;
    }

    /* Vision, Mission, Core Values Cards */
    .vmv-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .vmv-card {
      background: var(--white);
      border-radius: var(--radius-md);
      padding: 2.25rem 2rem;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--slate-200);
      border-top: 4px solid var(--gold-500);
      transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
    }

    .vmv-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
    }

    .vmv-icon {
      width: 54px;
      height: 54px;
      border-radius: var(--radius-sm);
      background: var(--navy-900);
      color: var(--gold-400);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.35rem;
    }

    .vmv-card h3 {
      font-size: 1.4rem;
      margin-bottom: 0.85rem;
    }

    .vmv-card p {
      color: var(--slate-600);
      font-size: 0.96rem;
    }

    .values-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      margin-top: 0.5rem;
    }

    .values-list li {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--navy-800);
    }

    .values-list li::before {
      content: '✦';
      color: var(--gold-600);
      font-size: 0.85rem;
    }

    /* ==========================================================================
       7. ACADEMIC PROGRAMS SECTION (WITH EDITABLE PREVIEW MODE)
       ========================================================================== */
    .programs-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      background: var(--white);
      padding: 1rem 1.5rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--slate-200);
      margin-bottom: 2.25rem;
      box-shadow: var(--shadow-sm);
    }

    .programs-toolbar-note {
      font-size: 0.9rem;
      color: var(--slate-600);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .programs-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
    }

    .program-card {
