  <!-- ========================================================================
       VANILLA JAVASCRIPT FUNCTIONALITY
       ======================================================================== -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      /* ----------------------------------------------------------------------
         1. DYNAMIC CURRENT YEAR IN FOOTER
         ---------------------------------------------------------------------- */
      const yearEl = document.getElementById('currentYear');
      if (yearEl) {
        yearEl.textContent = new Date().getFullYear();
      }

      /* ----------------------------------------------------------------------
         2. STICKY NAVBAR, ACTIVE SECTION HIGHLIGHT & BACK-TO-TOP BUTTON
         ---------------------------------------------------------------------- */
      const navbar = document.getElementById('navbar');
      const backToTopBtn = document.getElementById('backToTopBtn');
      const navLinks = document.querySelectorAll('.nav-link');
      const sections = document.querySelectorAll('main section[id]');

      function handleScroll() {
        const scrollY = window.scrollY;

        if (scrollY > 40) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }

        if (scrollY > 450) {
          backToTopBtn.classList.add('visible');
        } else {
          backToTopBtn.classList.remove('visible');
        }

        // Highlight active nav link based on scroll position
        let currentSectionId = 'home';
        sections.forEach((sec) => {
          const top = sec.offsetTop - 130;
          if (scrollY >= top) {
            currentSectionId = sec.getAttribute('id');
          }
        });

        navLinks.forEach((link) => {
          link.classList.remove('active');
          if (link.getAttribute('href') === `#${currentSectionId}`) {
            link.classList.add('active');
          }
        });
      }

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();

      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      /* ----------------------------------------------------------------------
         3. RESPONSIVE MOBILE NAVIGATION DRAWER
         ---------------------------------------------------------------------- */
      const hamburgerBtn = document.getElementById('hamburgerBtn');
      const mobileDrawer = document.getElementById('mobileDrawer');
      const mobileOverlay = document.getElementById('mobileOverlay');
      const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

      function toggleMobileMenu(forceState) {
        const isOpen = typeof forceState === 'boolean'
          ? forceState
          : !mobileDrawer.classList.contains('active');

        hamburgerBtn.classList.toggle('open', isOpen);
        mobileDrawer.classList.toggle('active', isOpen);
        mobileOverlay.classList.toggle('active', isOpen);
        hamburgerBtn.setAttribute('aria-expanded', String(isOpen));
        document.body.style.overflow = isOpen ? 'hidden' : '';
      }

      hamburgerBtn.addEventListener('click', () => toggleMobileMenu());
      mobileOverlay.addEventListener('click', () => toggleMobileMenu(false));
      mobileNavLinks.forEach((link) => {
        link.addEventListener('click', () => toggleMobileMenu(false));
      });

      /* ----------------------------------------------------------------------
         4. SCROLL REVEAL ANIMATIONS & ANIMATED COUNTERS
         ---------------------------------------------------------------------- */
      const revealElements = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      revealElements.forEach((el) => revealObserver.observe(el));

      // Animated Statistics Counters
      const counters = document.querySelectorAll('.counter');
      let countersStarted = false;

      function animateCounters() {
        if (countersStarted) return;
        countersStarted = true;

        counters.forEach((counter) => {
          const target = parseInt(counter.getAttribute('data-target'), 10);
          const duration = 1800;
          const startTime = performance.now();

          function updateCount(now) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // Ease-out cubic
            const eased = 1 - Math.pow(1 - progress, 3);
            counter.textContent = Math.floor(eased * target).toLocaleString();
            if (progress < 1) {
              requestAnimationFrame(updateCount);
            } else {
              counter.textContent = target.toLocaleString();
            }
          }

          requestAnimationFrame(updateCount);
        });
      }

      const statsSection = document.querySelector('.hero-stats');
      if (statsSection) {
        const statsObserver = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            animateCounters();
            statsObserver.disconnect();
          }
        }, { threshold: 0.25 });
        statsObserver.observe(statsSection);
      }

      /* ----------------------------------------------------------------------
         5. ACADEMIC PROGRAMS: CURRICULUM MODAL & EDITABLE CUSTOMIZATION MODE
         ---------------------------------------------------------------------- */
      const programDetailsData = {
        kg: {
          title: 'Kindergarten (Ages 3 – 6 | KG 1–3)',
          overview: 'Our Early Childhood program builds a joyful, secure bridge from home to school, nurturing curiosity, language fluency, and social confidence.',
          subjects: ['Early Phonics & Storytelling', 'Foundational Numeracy & Patterns', 'Environmental Discovery', 'Creative Arts, Rhythm & Movement', 'Social-Emotional & Character Habits'],
          schedule: 'Monday – Friday, 8:15 AM – 2:30 PM (with supervised play and rest periods).'
        },
        primary: {
          title: 'Primary Education (Grades 1 – 8)',
          overview: 'Primary Education establishes strong intellectual habits through active inquiry, bilingual literacy, mathematical reasoning, and introductory computer science.',
          subjects: ['English & Local Languages', 'Mathematics & Logic', 'Integrated General Science', 'Social Studies & Civics', 'ICT, Coding Fundamentals & Visual Arts'],
          schedule: 'Monday – Friday, 8:00 AM – 3:30 PM (including afternoon enrichment clubs).'
        },
        secondary: {
          title: 'Secondary Education (Grades 9 – 10)',
          overview: 'Designed to deepen analytical rigor across laboratory sciences, humanities, and mathematics while preparing students for national examinations.',
          subjects: ['Physics, Chemistry & Biology (Lab-Integrated)', 'Algebra, Geometry & Pre-Calculus', 'World History, Geography & Economics', 'English Composition & Literature', 'Information Technology & Research Skills'],
          schedule: 'Monday – Friday, 8:00 AM – 4:00 PM (with structured lab & study sessions).'
        },
        preparatory: {
          title: 'Preparatory Education (Grades 11 – 12)',
          overview: 'Our pre-university division equips scholars in Natural and Social Science streams with advanced academic mastery, entrance exam readiness, and leadership mentorship.',
          subjects: ['Natural Science Stream: Physics, Chemistry, Biology, Advanced Math', 'Social Science Stream: Economics, Geography, History, Business & Math', 'University Entrance Exam Intensive Clinics', 'Academic Research & Career Counseling'],
          schedule: 'Monday – Friday, 8:00 AM – 4:15 PM (plus Saturday university prep seminars).'
        }
      };

      const programModal = document.getElementById('programModal');
      const programModalTitle = document.getElementById('programModalTitle');
      const programModalBody = document.getElementById('programModalBody');

      document.querySelectorAll('.learn-more-program').forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-program');
          const data = programDetailsData[key];
          if (!data) return;

          programModalTitle.textContent = data.title;
          programModalBody.innerHTML = `
            <p style="margin-bottom: 1.1rem; color: var(--slate-700);">${data.overview}</p>
            <h4 style="font-size: 1.08rem; margin-bottom: 0.6rem; color: var(--navy-900);">Core Curriculum Highlights</h4>
            <ul style="margin-left: 1.25rem; margin-bottom: 1.25rem; color: var(--slate-600); display: flex; flex-direction: column; gap: 0.4rem;">
              ${data.subjects.map((sub) => `<li>${sub}</li>`).join('')}
            </ul>
            <div style="background: var(--slate-50); padding: 0.95rem 1.15rem; border-radius: var(--radius-sm); border-left: 3px solid var(--gold-500); margin-bottom: 1.35rem; font-size: 0.9rem;">
              <strong>Daily Academic Schedule:</strong> ${data.schedule}
            </div>
            <button type="button" class="btn btn-gold open-apply-from-program" style="width: 100%;">Apply for This Program</button>
          `;

          openModal(programModal);

          const applyBtn = programModalBody.querySelector('.open-apply-from-program');
          if (applyBtn) {
            applyBtn.addEventListener('click', () => {
              closeModal(programModal);
              openModal(document.getElementById('applyModal'));
            });
          }
        });
      });

      // Editable Program Cards Toggle (for school staff customization)
      const toggleEditBtn = document.getElementById('toggleEditProgramsBtn');
      const resetProgramsBtn = document.getElementById('resetProgramsBtn');
      const editStatusText = document.getElementById('editStatusText');
      const programCards = document.querySelectorAll('.program-card');
      const defaultProgramsSnapshot = {};

      programCards.forEach((card) => {
        const id = card.getAttribute('data-program-id');
        defaultProgramsSnapshot[id] = {
          title: card.querySelector('[data-field="title"]').textContent.trim(),
          desc: card.querySelector('[data-field="desc"]').textContent.trim()
        };
      });

      let isEditingPrograms = false;

      toggleEditBtn.addEventListener('click', () => {
        isEditingPrograms = !isEditingPrograms;
        programCards.forEach((card) => {
          card.classList.toggle('editing', isEditingPrograms);
          card.querySelector('[data-field="title"]').setAttribute('contenteditable', String(isEditingPrograms));
          card.querySelector('[data-field="desc"]').setAttribute('contenteditable', String(isEditingPrograms));
        });

        if (isEditingPrograms) {
          toggleEditBtn.textContent = 'Save Changes';
          toggleEditBtn.classList.remove('btn-outline-navy');
          toggleEditBtn.classList.add('btn-gold');
          resetProgramsBtn.style.display = 'inline-flex';
          editStatusText.innerHTML = '<strong>Edit Mode Active:</strong> Click any program title or description below to customize it.';
        } else {
          toggleEditBtn.textContent = 'Customize Programs';
          toggleEditBtn.classList.add('btn-outline-navy');
          toggleEditBtn.classList.remove('btn-gold');
          editStatusText.innerHTML = '<strong>Saved!</strong> Program descriptions have been updated for this session.';
        }
      });

      resetProgramsBtn.addEventListener('click', () => {
        programCards.forEach((card) => {
          const id = card.getAttribute('data-program-id');
          card.querySelector('[data-field="title"]').textContent = defaultProgramsSnapshot[id].title;
          card.querySelector('[data-field="desc"]').textContent = defaultProgramsSnapshot[id].desc;
        });
        editStatusText.innerHTML = 'Program titles and descriptions restored to defaults.';
      });

      /* ----------------------------------------------------------------------
         6. TEACHERS DEPARTMENT FILTER
         ---------------------------------------------------------------------- */
      const teacherFilterBtns = document.querySelectorAll('[data-teacher-filter]');
      const teacherCards = document.querySelectorAll('.teacher-card');

      teacherFilterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          teacherFilterBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const filter = btn.getAttribute('data-teacher-filter');

          teacherCards.forEach((card) => {
            const dept = card.getAttribute('data-dept');
            if (filter === 'all' || dept === filter) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      /* ----------------------------------------------------------------------
         7. INTERACTIVE SCHOOL GALLERY & LIGHTBOX PREVIEW
         ---------------------------------------------------------------------- */
      const galleryFilterBtns = document.querySelectorAll('[data-gallery-filter]');
      const galleryItems = Array.from(document.querySelectorAll('.gallery-item'));
      const lightboxModal = document.getElementById('lightboxModal');
      const lightboxImg = document.getElementById('lightboxImg');
      const lightboxCategory = document.getElementById('lightboxCategory');
      const lightboxTitle = document.getElementById('lightboxTitle');
      let currentLightboxIndex = 0;

      galleryFilterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          galleryFilterBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const cat = btn.getAttribute('data-gallery-filter');

          galleryItems.forEach((item) => {
            if (cat === 'all' || item.getAttribute('data-category') === cat) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });

      function showLightbox(index) {
        currentLightboxIndex = (index + galleryItems.length) % galleryItems.length;
        const item = galleryItems[currentLightboxIndex];
        const img = item.querySelector('img');
        const cat = item.querySelector('.gallery-cat').textContent;
        const caption = item.querySelector('.gallery-caption').textContent;

        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightboxCategory.textContent = cat;
        lightboxTitle.textContent = caption;
        openModal(lightboxModal);
      }

      galleryItems.forEach((item, idx) => {
        item.addEventListener('click', () => showLightbox(idx));
        item.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            showLightbox(idx);
          }
        });
      });

      document.getElementById('lightboxPrev').addEventListener('click', () => showLightbox(currentLightboxIndex - 1));
      document.getElementById('lightboxNext').addEventListener('click', () => showLightbox(currentLightboxIndex + 1));
      document.getElementById('closeLightboxBtn').addEventListener('click', () => closeModal(lightboxModal));

      /* ----------------------------------------------------------------------
         8. NEWS & EVENTS FULL NOTICE MODAL
         ---------------------------------------------------------------------- */
      const newsArticles = [
        {
          title: '2026/2027 Admissions & Merit Scholarship Applications Open',
          date: 'November 18, 2026 | School Announcement',
          content: 'HABTAMU EDUCATION PROJECT is pleased to announce that admissions for the upcoming academic year are officially open across Kindergarten, Primary, Secondary, and Preparatory divisions. Full and partial merit scholarships are available for top-performing incoming students in Grades 7–12. Visit our Admissions Office or apply online today.'
        },
        {
          title: 'Annual STEM Innovation Fair & Open Campus Day',
          date: 'December 5, 2026 | Upcoming Event (9:00 AM – 2:00 PM)',
          content: 'Join students, faculty, and invited science educators for our Annual STEM Innovation Fair. Exhibits include student-built robotics models, renewable energy prototypes, coding showcases, and guided tours of our science laboratories and library.'
        },
        {
          title: 'Preparatory Class Achieves 99.2% University Entrance Pass Rate',
          date: 'October 24, 2026 | Academic Achievement',
          content: 'Congratulations to our graduating Preparatory cohort and dedicated faculty! Over 99.2% of our candidates earned qualifying university placement scores, with 42 students scoring in the top national percentile across Natural and Social Science streams.'
        },
        {
          title: 'Mid-Term Parent-Teacher Academic Consultation Schedule',
          date: 'December 12, 2026 | Important Notice',
          content: 'All parents and guardians are cordially invited to attend individual student progress reviews on Friday, December 12. Detailed mid-term performance portfolios will be shared, and parents may schedule 15-minute consultations with homeroom and subject teachers.'
        }
      ];

      const newsModal = document.getElementById('newsModal');
      const newsModalTitle = document.getElementById('newsModalTitle');
      const newsModalBody = document.getElementById('newsModalBody');

      document.querySelectorAll('[data-news-index]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const item = newsArticles[Number(btn.getAttribute('data-news-index'))];
          if (!item) return;
          newsModalTitle.textContent = item.title;
          newsModalBody.innerHTML = `
            <p style="font-size: 0.85rem; font-weight: 700; color: var(--gold-600); margin-bottom: 1rem;">${item.date}</p>
            <p style="color: var(--slate-700); line-height: 1.75; margin-bottom: 1.5rem;">${item.content}</p>
            <button type="button" class="btn btn-navy btn-sm" data-close-modal="newsModal">Close Notice</button>
          `;
          openModal(newsModal);
          newsModalBody.querySelector('[data-close-modal]').addEventListener('click', () => closeModal(newsModal));
        });
      });

      /* ----------------------------------------------------------------------
         9. UNIVERSAL MODAL HELPERS & ONLINE APPLICATION MODAL
         ---------------------------------------------------------------------- */
      function openModal(modal) {
        if (!modal) return;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeModal(modal) {
        if (!modal) return;
        modal.classList.remove('active');
        if (!mobileDrawer.classList.contains('active')) {
          document.body.style.overflow = '';
        }
      }

      document.querySelectorAll('.open-apply-modal').forEach((btn) => {
        btn.addEventListener('click', () => {
          toggleMobileMenu(false);
          openModal(document.getElementById('applyModal'));
        });
      });

      document.querySelectorAll('[data-close-modal]').forEach((btn) => {
        btn.addEventListener('click', () => {
          closeModal(document.getElementById(btn.getAttribute('data-close-modal')));
        });
      });

      document.querySelectorAll('.modal-backdrop').forEach((backdrop) => {
        backdrop.addEventListener('click', (e) => {
          if (e.target === backdrop) {
            closeModal(backdrop);
          }
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.querySelectorAll('.modal-backdrop.active').forEach((m) => closeModal(m));
          toggleMobileMenu(false);
        } else if (lightboxModal.classList.contains('active')) {
          if (e.key === 'ArrowRight') showLightbox(currentLightboxIndex + 1);
          if (e.key === 'ArrowLeft') showLightbox(currentLightboxIndex - 1);
        }
      });

      // Preliminary Application Form Submission
      const applyForm = document.getElementById('applyForm');
      const applyFeedback = document.getElementById('applyFeedback');

      applyForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const studentName = document.getElementById('studentName').value.trim();
        const applyProgram = document.getElementById('applyProgram').value;
        const parentName = document.getElementById('parentName').value.trim();
        const parentPhone = document.getElementById('parentPhone').value.trim();
        const parentEmail = document.getElementById('parentEmail').value.trim();

        if (!studentName || !applyProgram || !parentName || !parentPhone || !parentEmail.includes('@')) {
          applyFeedback.className = 'form-feedback';
          applyFeedback.style.display = 'block';
          applyFeedback.style.background = 'var(--error-bg)';
          applyFeedback.style.color = 'var(--error)';
          applyFeedback.textContent = 'Please fill out all required fields with valid information.';
          return;
        }

        applyFeedback.style = '';
        applyFeedback.className = 'form-feedback success';
        applyFeedback.textContent = `Thank you, ${parentName}! Preliminary application for ${studentName} (${applyProgram}) has been received. Our Admissions Office will contact you shortly.`;
        applyForm.reset();
      });

      /* ----------------------------------------------------------------------
         10. CONTACT FORM REAL-TIME VALIDATION
         ---------------------------------------------------------------------- */
      const contactForm = document.getElementById('contactForm');
      const contactFeedback = document.getElementById('contactFeedback');

      function validateEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }

      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        let isValid = true;

        const nameInput = document.getElementById('contactName');
        const emailInput = document.getElementById('contactEmail');
        const subjectInput = document.getElementById('contactSubject');
        const messageInput = document.getElementById('contactMessage');

        const errName = document.getElementById('errName');
        const errEmail = document.getElementById('errEmail');
        const errSubject = document.getElementById('errSubject');
        const errMessage = document.getElementById('errMessage');

        // Validate Name
        if (nameInput.value.trim().length < 2) {
          nameInput.classList.add('invalid');
          errName.classList.add('visible');
          isValid = false;
        } else {
          nameInput.classList.remove('invalid');
          errName.classList.remove('visible');
        }

        // Validate Email
        if (!validateEmail(emailInput.value.trim())) {
          emailInput.classList.add('invalid');
          errEmail.classList.add('visible');
          isValid = false;
        } else {
          emailInput.classList.remove('invalid');
          errEmail.classList.remove('visible');
        }

        // Validate Subject
        if (!subjectInput.value) {
          subjectInput.classList.add('invalid');
          errSubject.classList.add('visible');
          isValid = false;
        } else {
          subjectInput.classList.remove('invalid');
          errSubject.classList.remove('visible');
        }

        // Validate Message
        if (messageInput.value.trim().length < 10) {
          messageInput.classList.add('invalid');
          errMessage.classList.add('visible');
          isValid = false;
        } else {
          messageInput.classList.remove('invalid');
          errMessage.classList.remove('visible');
        }

        if (isValid) {
          contactFeedback.className = 'form-feedback success';
          contactFeedback.textContent = `Thank you, ${nameInput.value.trim()}! Your message regarding "${subjectInput.value}" has been sent to HABTAMU EDUCATION PROJECT.`;
          contactForm.reset();
        }
      });
    });
  </script>
</body>
</html>
