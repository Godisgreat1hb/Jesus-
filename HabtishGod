      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      font-size: 0.86rem;
      color: var(--slate-500);
    }

    .back-to-top {
      position: fixed;
      bottom: 26px;
      right: 26px;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--navy-900);
      color: var(--gold-400);
      border: 2px solid var(--gold-500);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-lg);
      z-index: 900;
      opacity: 0;
      visibility: hidden;
      transform: translateY(15px);
      transition: all var(--transition-smooth);
    }

    .back-to-top.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .back-to-top:hover {
      background: var(--gold-500);
      color: var(--navy-950);
    }

    /* ==========================================================================
       16. MODALS (LIGHTBOX, PROGRAM DETAILS, APPLICATION FORM, NEWS NOTICE)
       ========================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(6, 15, 30, 0.84);
      backdrop-filter: blur(6px);
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      opacity: 0;
      visibility: hidden;
      transition: all var(--transition-smooth);
    }

    .modal-backdrop.active {
      opacity: 1;
      visibility: visible;
    }

    .modal-dialog {
      background: var(--white);
      border-radius: var(--radius-lg);
      max-width: 640px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
      transform: scale(0.94);
      transition: transform var(--transition-smooth);
    }

    .modal-backdrop.active .modal-dialog {
      transform: scale(1);
    }

    .modal-header {
      background: var(--navy-900);
      color: var(--white);
      padding: 1.5rem 1.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 3px solid var(--gold-500);
    }

    .modal-header h3 {
      color: var(--white);
      font-size: 1.38rem;
    }

    .modal-close {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      color: var(--white);
      font-size: 1.35rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background var(--transition-fast);
    }

    .modal-close:hover {
      background: var(--gold-500);
      color: var(--navy-950);
    }

    .modal-body {
      padding: 1.85rem;
    }

    /* Lightbox Specific */
    .lightbox-dialog {
      background: transparent;
      max-width: 920px;
      box-shadow: none;
      text-align: center;
      overflow: visible;
    }

    .lightbox-img-wrap {
      position: relative;
      background: var(--navy-950);
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 2px solid rgba(212, 175, 55, 0.4);
    }

    .lightbox-img-wrap img {
      max-height: 72vh;
      width: 100%;
      object-fit: contain;
      margin: 0 auto;
    }

    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: rgba(10, 25, 47, 0.85);
      color: var(--gold-400);
      border: 1px solid var(--gold-500);
      font-size: 1.35rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lightbox-nav:hover {
      background: var(--gold-500);
      color: var(--navy-950);
    }

    .lightbox-prev { left: 14px; }
    .lightbox-next { right: 14px; }

    .lightbox-meta {
      margin-top: 1rem;
      color: var(--white);
    }

    .lightbox-meta span {
      color: var(--gold-400);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 700;
    }

    .lightbox-meta h4 {
      color: var(--white);
      font-size: 1.25rem;
      margin-top: 0.25rem;
    }

    /* ==========================================================================
       17. RESPONSIVE MEDIA QUERIES
       ========================================================================== */
    @media (max-width: 1120px) {
      .nav-links {
        display: none;
      }
      .hamburger {
        display: flex;
      }
