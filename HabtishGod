      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.65s ease, opacity 0.4s ease;
    }

    .gallery-item:hover img {
      transform: scale(1.09);
      opacity: 0.85;
    }

    .gallery-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(6, 15, 30, 0.92) 0%, rgba(6, 15, 30, 0.15) 65%, transparent 100%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1.4rem;
      color: var(--white);
      transition: opacity var(--transition-smooth);
    }

    .gallery-cat {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--gold-400);
      font-weight: 700;
      margin-bottom: 0.25rem;
    }

    .gallery-caption {
      font-family: var(--font-serif);
      font-size: 1.12rem;
      font-weight: 600;
    }

    .gallery-zoom-icon {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(10, 25, 47, 0.82);
      color: var(--gold-400);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(212, 175, 55, 0.4);
      opacity: 0;
      transform: scale(0.85);
      transition: all var(--transition-fast);
    }

    .gallery-item:hover .gallery-zoom-icon {
      opacity: 1;
      transform: scale(1);
    }

    /* ==========================================================================
       12. NEWS & EVENTS SECTION
       ========================================================================== */
    .news-grid {
      display: grid;
