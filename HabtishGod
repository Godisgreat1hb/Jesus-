    .form-box {
      background: var(--white);
      padding: 2.5rem;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      border: 1px solid var(--slate-200);
    }

    .form-box h3 {
      font-size: 1.65rem;
      margin-bottom: 0.5rem;
